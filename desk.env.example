# Copy to desk.env and edit. Real environment variables override this file.

# --- execution -------------------------------------------------------------------------------
# LIVE=0  place_order.py only simulates fills (safe default).
# LIVE=1  orders go to the broker. Paper mode (start_desk.sh paper) never sends orders either way.
#   BROKER=oanda: OANDA_ENV=practice is a demo account (fake money), OANDA_ENV=live is REAL MONEY.
#   BROKER=mt5:   the MT5 terminal under Wine (mt5_client.py), whatever account it is logged into;
#                 demo accounts only unless MT5_ALLOW_REAL=1. Orders go in lots (min 0.01 lot = 1,000
#                 units of a forex pair), so --budget / MAX_NOTIONAL_USD must allow at least that.
LIVE=0
BROKER=oanda
OANDA_ENV=practice
OANDA_TOKEN=
OANDA_ACCOUNT=
MT5_MAGIC=21102026          # tags the forex desk's MT5 positions
MT5_ALLOW_REAL=0

# --- market data: auto = MT5 when BROKER=mt5, else OANDA when OANDA_TOKEN is set, else Yahoo ----
DATA_SOURCE=auto

# --- hard limits, enforced in code (the agents cannot override them) -------------------------
RISK_PER_TRADE_PCT=1.0      # % of --budget lost if a full-size trade hits its stop
MAX_LEVERAGE=10             # position value <= this x budget
MAX_NOTIONAL_USD=1000       # place_order.py refuses any single order worth more than this
DAILY_LOSS_LIMIT_PCT=3      # no new trades once today's realized loss reaches this % of budget
MIN_CONFIDENCE=0.6          # boss confidence needed to open a trade
MIN_REWARD_RISK=1.5
EVENT_BLACKOUT_HOURS=2      # no new trades this close to a high-impact release
MAX_SLIPPAGE_PIPS=3         # LIVE market orders do not fill further than this from the desk's price
SPREAD_PIPS=                # simulated spread; empty = typical spread for the pair

# --- OpenClaw handoff (start_desk.sh openclaw) ------------------------------------------------
OPENCLAW_CMD=openclaw agent --agent main --json --timeout 300
OPENCLAW_TIMEOUT=360
